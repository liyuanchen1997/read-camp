{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/scripts/check-doc-sync.py",
            "if": "Bash(git commit*)",
            "timeout": 15,
            "statusMessage": "检查文档同步…"
          },
          {
            "type": "command",
            "command": ".claude/scripts/check-doc-sync.py",
            "if": "Bash(git push*)",
            "timeout": 15,
            "statusMessage": "检查文档同步…"
          }
        ]
      }
    ]
  }
}
